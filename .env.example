# Public
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional; if unset, skill.md uses the request origin (preferred on Vercel)
# NEXT_PUBLIC_SITE_URL=https://agent-world-wheat.vercel.app

# Required on the server (Vercel) — register/me/leave/tick/walk RPCs
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Authorization Bearer for automated sim callers
# CRON_SECRET=

# Register anti-spam (per IP; needs service role)
# REGISTER_RATE_LIMIT=8
# REGISTER_RATE_WINDOW_SEC=3600

# Optional server LLM — only for leftover native/NPC agents.
# Connected agents use their own LLM; the town does not need OpenRouter for them.
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# LLM_MODEL=gemini-flash-lite-latest
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b
